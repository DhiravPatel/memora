# Application
APP_ENV=development
APP_NAME=ai-memory-layer
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=INFO
LOG_JSON=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/memory
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Language engine
# There is no model provider: extraction, consolidation, retrieval and answering are
# deterministic and run in-process. EMBEDDING_DIMENSIONS is the width of the pgvector
# column, so changing it requires a migration and a re-embed.
EMBEDDING_DIMENSIONS=1536
NLP_DETECT_PROPER_NOUNS=true
NLP_MAX_MEMORIES_PER_EVENT=6
NLP_SUMMARY_SENTENCES=3

# Authentication
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30
API_KEY_SECRET=change-me-in-production

# Encrypts the two secrets that cannot be hashed, because signing needs the value back:
# outbound webhook secrets and inbound integration signing secrets. Required in production
# — hold it in a KMS and inject it. Generate one with:
#   python -c "from common.crypto import generate_key; print(generate_key())"
SECRETS_ENCRYPTION_KEY=change-me-in-production
# Older keys, newest first, kept readable while rows are rewritten under a new key.
# See scripts/encrypt_secrets.py for the rotation.
PREVIOUS_ENCRYPTION_KEYS=

# Email. SMTP rather than a provider SDK, so switching providers is configuration.
# Leave SMTP_HOST unset in development: messages are logged instead of sent, including
# the invitation link, which is the only thing you need out of them locally.
#   auto    send when SMTP_HOST is set, log otherwise (default)
#   console always log — refused in production, it puts invite links in the log stream
#   null    send nothing, deliberately. The only way production accepts having no mail.
EMAIL_TRANSPORT=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Implicit TLS (port 465). Otherwise STARTTLS upgrades the connection (port 587).
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM=no-reply@localhost
EMAIL_FROM_NAME=Memora
# Where a link in an email points. Defaults to APP_URL.
EMAIL_LINK_BASE_URL=

# Key rotation. The nightly check warns when the secrets key is older than this, or when
# a rotation was started and scripts/encrypt_secrets.py was never run. 0 disables the age
# check; the unfinished-rotation check always runs.
KEY_ROTATION_MAX_AGE_DAYS=90
# Where that warning is emailed. Empty means log only.
OPS_ALERT_EMAIL=

# CORS
CORS_ORIGINS=http://localhost:3000

# Memory engine
MEMORY_MIN_EVENT_IMPORTANCE=0.2
MEMORY_CONSOLIDATION_SIMILARITY=0.45
MEMORY_AUTO_MERGE_SIMILARITY=0.82
MEMORY_DEFAULT_DECAY_DAYS=90
MEMORY_CONTEXT_TOKEN_BUDGET=2000
MEMORY_RETRIEVAL_CANDIDATES=50
RANK_WEIGHT_SIMILARITY=0.35
RANK_WEIGHT_IMPORTANCE=0.20
RANK_WEIGHT_CONFIDENCE=0.20
RANK_WEIGHT_RECENCY=0.15
RANK_WEIGHT_RELATIONSHIP=0.10

# Privacy
PII_REDACTION_ENABLED=true

# Retention (days; 0 = keep indefinitely)
RETENTION_EVENT_DAYS=90
RETENTION_MEMORY_DAYS=0
RETENTION_CONVERSATION_DAYS=30
